PORT=
NODE_ENV=

# Use a replica set URI so transactions / change streams work:
#   mongodb://localhost:27018/transport_tracking?replicaSet=rs0
MONGO_URI=

# Bootstrap admin user created by the seed script (scripts/seed.ts)
ADMIN_EMAIL=
ADMIN_PASSWORD=

REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_DAYS=30
GUEST_EXPIRES_IN=1d

CORS_ORIGIN=

GPS_UPDATE_INTERVAL_SECONDS=
VEHICLE_OFFLINE_THRESHOLD_SECONDS=
GEOFENCE_RADIUS_METERS=

# OTP abuse protection
OTP_MAX_ATTEMPTS=5
OTP_ATTEMPT_WINDOW=600
OTP_LOCKOUT=900
OTP_RESEND_COOLDOWN=60
OTP_TTL=600
OTP_NUMBER_WINDOW=3600
OTP_NUMBER_LIMIT=5
OTP_IP_WINDOW=3600
OTP_IP_LIMIT=20
